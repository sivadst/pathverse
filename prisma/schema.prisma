generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(cuid())
  email     String          @unique
  name      String
  role      UserRole        @default(MEMBER)
  profile   GrowthProfile?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model GrowthProfile {
  id          String              @id @default(cuid())
  userId      String              @unique
  headline    String
  targetTrack String
  level       Int                 @default(1)
  xp          Int                 @default(0)
  streakDays  Int                 @default(0)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      SkillSnapshot[]
  milestones  RoadmapMilestone[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model SkillSnapshot {
  id        String        @id @default(cuid())
  profileId String
  name      String
  category  String
  current   Int
  target    Int
  velocity  Int
  profile   GrowthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model RoadmapMilestone {
  id        String        @id @default(cuid())
  profileId String
  week      Int
  title     String
  outcome   String
  intensity String
  done      Boolean       @default(false)
  profile   GrowthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  COACH
  MEMBER
}
